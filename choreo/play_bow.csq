name: "play_bow"
slices_per_minute: 480.0
moves {
  type: "body_hold"
  requested_slices: 6
  body_hold_params {
    rotation {
      roll {
        value: 0.01
      }
      pitch {
        value: 0.12
      }
      yaw {
        value: 0.01
      }
    }
    translation {
      x {
      }
      y {
      }
      z {
        value: 1e-06
      }
    }
    entry_slices {
      value: 5.0
    }
    exit_slices {
      value: 1e-06
    }
  }
}
moves {
  type: "sway"
  start_slice: 6
  requested_slices: 32
  sway_params {
    vertical {
    }
    horizontal {
      value: 0.05
    }
    roll {
      value: 0.05
    }
    pivot: PIVOT_FRONT
    style: SWAY_STYLE_STANDARD
    pronounced {
      value: 0.5
    }
    hold_zero_axes {
      value: true
    }
  }
}
